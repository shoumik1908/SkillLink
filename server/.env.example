# Neon PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-3.aws.neon.tech/neondb?sslmode=require

# JWT Configuration (Secret must be at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Campus email domain restriction (default muj.manipal.edu)
ALLOWED_EMAIL_DOMAIN=muj.manipal.edu

# Daily signup cap to limit spam waves
MAX_DAILY_SIGNUPS=500

# SMTP Email Configuration (If not configured in dev, links are logged to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkillLink <no-reply@muj.manipal.edu>"

# Seed credentials for seeding script (scripts/seedUsers.js)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STUDENT_NAME=
STUDENT_EMAIL=
STUDENT_PASSWORD=

# Frontend Client Origin for CORS and link redirects
CLIENT_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development
PORT=5000
