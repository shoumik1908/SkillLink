# SkillLink Frontend Environment Variables (.env)
# 
# OPTION 1 (Recommended): Leave VITE_API_BASE_URL empty or unset.
# When hosted on Vercel, the rewrites in vercel.json will automatically proxy
# all '/api/*' requests directly to your backend on Render.
# This prevents cross-origin cookie blocking in Safari, Chrome, and iOS.
#
# OPTION 2: If you prefer direct cross-origin calls without Vercel rewrites:
# VITE_API_BASE_URL=https://your-skilllink-server.onrender.com/api
